# MIZANORA — Environment variables template
# Copy to .env for local tooling reference. The BROWSER reads config from
# public/js/services/firebase-init.js (Firebase config, safe to expose)
# and public/js/env.js (generated locally — see README, NEVER committed).
#
# Firebase Console > Project Settings > General > Your apps > SDK setup
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_DATABASE_URL=

# ImgBB — https://api.imgbb.com/  (this is a real secret; see README)
IMGBB_API_KEY=
