rules_version = '2';

// =====================================================================
// MIZANORA — Firestore Security Rules
//
// Golden rule: customers can READ what's public and WRITE only their
// own customer-scoped data. Every business-critical write (orders,
// prices, stock, admin roles, review approval) goes through Cloud
// Functions using the Admin SDK, which bypasses these rules by design
// — so a client-side write attempt at that data is always denied here.
// =====================================================================

function isSignedIn() {
  return request.auth != null;
}

function isAdmin() {
  return isSignedIn() && request.auth.token.admin == true;
}

function isOwner(uid) {
  return isSignedIn() && request.auth.uid == uid;
}

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // PRODUCTS — public read, admin-only write
    // ---------------------------------------------------------------
    match /products/{productId} {
      allow read: if resource.data.active == true || isAdmin();
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // CATEGORIES / COLLECTIONS — public read, admin-only write
    // ---------------------------------------------------------------
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /collections/{collectionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // ORDERS — customers can read only their own; nobody writes
    // directly. All order writes happen via the createOrder /
    // updateOrderStatus Cloud Functions (Admin SDK bypasses rules).
    // ---------------------------------------------------------------
    match /orders/{orderId} {
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.customerId == request.auth.uid);
      // Guest orders are looked up via the trackOrder callable
      // (server-verified by orderId + phone), never by direct client read.
      allow write: if false;

      match /order_history/{eventId} {
        allow read: if isAdmin()
                    || (isSignedIn() && get(/databases/$(database)/documents/orders/$(orderId)).data.customerId == request.auth.uid);
        allow write: if false; // Cloud Functions only
      }
    }

    // ---------------------------------------------------------------
    // CUSTOMERS — a user can read/update their own profile fields
    // only. Cannot alter role/admin-like fields (none exist on this
    // doc by design — role lives in /admins, not here).
    // ---------------------------------------------------------------
    match /customers/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();

      match /addresses/{addressId} {
        allow read, write: if isOwner(uid);
      }

      match /wishlist/{productId} {
        allow read, write: if isOwner(uid);
      }

      match /cart/{itemId} {
        allow read, write: if isOwner(uid);
      }
    }

    // ---------------------------------------------------------------
    // REVIEWS — anyone can read approved reviews; a signed-in
    // customer can create a pending review; only admins can change
    // status (approve/reject) or edit after creation.
    // ---------------------------------------------------------------
    match /reviews/{reviewId} {
      allow read: if resource.data.status == 'approved' || isAdmin()
                  || (isSignedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.customerId == request.auth.uid
                    && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // COUPONS — never publicly listable (prevents scraping every
    // code); a specific code is validated via the validateCoupon
    // Cloud Function, not a direct client read of the collection.
    // ---------------------------------------------------------------
    match /coupons/{couponId} {
      allow get: if isAdmin(); // even a single-doc get requires admin;
                               // customers validate via callable only
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // BANNERS / STORE CONTENT — public read (drives homepage CMS),
    // admin-only write.
    // ---------------------------------------------------------------
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /store_content/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // ADMINS — an admin doc is only ever written by the setAdminRole
    // Cloud Function. Admins can read the list (to manage roles);
    // nobody else can even confirm who is an admin.
    // ---------------------------------------------------------------
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false; // Cloud Functions only
    }

    // ---------------------------------------------------------------
    // RESELLERS — admin managed
    // ---------------------------------------------------------------
    match /resellers/{resellerId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // NOTIFICATIONS — a customer reads only notifications addressed
    // to them; admins manage/send.
    // ---------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if isAdmin()
                  || (isSignedIn() && resource.data.customerId == request.auth.uid)
                  || resource.data.audience == 'all';
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // COUNTERS — used only by the createOrder Cloud Function (via the
    // Admin SDK, which bypasses these rules entirely) to generate
    // sequential daily order IDs. Deliberately NOT matched below, so
    // the default-deny at the bottom blocks every client SDK access —
    // correct, since no client should ever read or write a counter.
    // ---------------------------------------------------------------

    // Default deny — anything not explicitly matched above is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
