# ===== Site =====
NEXT_PUBLIC_SITE_URL=https://mizanora.vercel.app
NEXT_PUBLIC_WHATSAPP_NUMBER=923062015326
# 0 = free delivery. Set e.g. 250 to charge Rs. 250 delivery.
NEXT_PUBLIC_SHIPPING_FEE=0
NEXT_PUBLIC_FACEBOOK_URL=
# Google Search Console "HTML tag" verification: paste only the content="..." value
NEXT_PUBLIC_GSC_VERIFICATION=

# ===== Firebase (Project settings > General > Your apps > Web app) =====
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# The admin login email you create in Firebase Authentication
NEXT_PUBLIC_ADMIN_EMAIL=

# ===== Firebase Admin (Project settings > Service accounts > Generate new private key) =====
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value in double quotes, keeping the \n characters
FIREBASE_PRIVATE_KEY=
# The UID of the admin user (Authentication > Users > User UID)
ADMIN_UID=

# ===== Meta (Facebook/Instagram) =====
NEXT_PUBLIC_META_PIXEL_ID=
# Events Manager > Settings > Conversions API > Generate access token
META_CAPI_TOKEN=
# Optional: only while testing in Events Manager > Test events
META_TEST_EVENT_CODE=
